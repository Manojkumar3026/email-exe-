# Google Cloud Console OAuth client (type: Chrome Extension), used in manifest oauth2.client_id
VITE_GOOGLE_CLIENT_ID=

# Azure App Registration (public client / mobile & desktop), used for the Microsoft PKCE flow
VITE_MS_CLIENT_ID=
# "common" allows both personal Microsoft accounts and work/school accounts. Use a specific tenant id to restrict.
VITE_MS_TENANT=common
